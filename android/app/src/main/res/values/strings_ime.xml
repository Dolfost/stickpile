<?xml version="1.0" encoding="utf-8"?>
<!-- Texts of the picker keyboard (package ime). -->
<resources>
    <!-- The button that switches back to the keyboard used before (content description). -->
    <string name="ime_back_to_keyboard">Back to the keyboard</string>

    <!-- The search bar: the search box (its hint and clear button) and the menu button (content description). -->
    <string name="ime_search_hint">Search stickers</string>
    <!-- The search box's hint with a set open: it searches only there. %1$s: the set's name. -->
    <string name="ime_search_in_set">Search in %1$s</string>
    <string name="ime_search_clear">Clear the search</string>
    <string name="ime_menu">More options</string>
    <string name="ime_close">Close</string>

    <!-- Tabs. Results shows while something is searched for. -->
    <string name="ime_tab_results">Results</string>
    <string name="ime_tab_recent">Recent</string>
    <string name="ime_tab_liked">Liked</string>
    <string name="ime_tab_most_used">Most used</string>
    <string name="ime_tab_sets">Sets</string>

    <!--
      The search keys: the names of the layouts (on the space bar, each in
      its own language), the labels of the keys between letters and
      symbols, and the content descriptions of the keys without a letter.
    -->
    <string name="ime_layout_english">English</string>
    <string name="ime_layout_ukrainian">Українська</string>
    <string name="ime_key_symbols_label">123</string>
    <string name="ime_key_letters_english">abc</string>
    <string name="ime_key_letters_ukrainian">абв</string>
    <string name="ime_key_symbols">Symbols</string>
    <string name="ime_key_letters">Letters</string>
    <string name="ime_key_language">Next language</string>
    <string name="ime_key_space">Space</string>
    <string name="ime_key_backspace">Delete</string>
    <string name="ime_key_done">Done</string>

    <!-- A set's items: the button back to the list of sets. -->
    <string name="ime_all_sets">All sets</string>
    <!-- Under a set's name in the list: its owner and how many stickers it has. -->
    <string name="ime_set_summary">%1$s - %2$s</string>
    <plurals name="ime_set_items">
        <item quantity="one">%d sticker</item>
        <item quantity="other">%d stickers</item>
    </plurals>

    <!-- Empty lists. -->
    <string name="ime_empty_recent">Nothing sent from here yet. Pick a sticker in Liked or Sets.</string>
    <string name="ime_empty_liked">Nothing liked yet.</string>
    <string name="ime_empty_most_used">Nothing sent yet.</string>
    <string name="ime_empty_sets">No sets yet.</string>
    <string name="ime_empty_set">This set is empty.</string>
    <string name="ime_empty_results">Nothing found for \"%1$s\".</string>
    <string name="ime_empty_set_results">Nothing in this set for \"%1$s\".</string>
    <string name="ime_offline">Offline: showing saved stickers.</string>
    <string name="ime_loading">Loading</string>

    <!-- Signed out: the message and the button that opens the app. -->
    <string name="ime_signed_out">Sign in to stickpile to use your stickers here.</string>
    <string name="ime_open_app">Open stickpile</string>

    <!-- What went wrong, in a short line inside the keyboard. -->
    <string name="ime_error_unreachable">Can\'t reach the server, and nothing is saved for offline use.</string>
    <string name="ime_error_not_found">This sticker is gone.</string>
    <string name="ime_error_rate_limited">Too many requests. Try again in a minute.</string>
    <string name="ime_error_nothing_fits">This sticker can\'t be sent here.</string>
    <string name="ime_error_server">The server had a problem. Try again later.</string>
    <string name="ime_error_io">Couldn\'t read the saved stickers.</string>
    <string name="ime_error_failed">Something went wrong.</string>
    <string name="ime_error_not_on_device">Not on this phone, and the server is away. Keep it offline from its menu.</string>
    <!-- A tile for accessibility services: %1$s is the sticker's name. -->
    <string name="ime_unavailable_item">%1$s, not on this phone</string>
    <string name="ime_error_no_app">No app to share it with.</string>

    <!-- After a pick that could not go into the field directly. -->
    <string name="ime_copied">Copied. Switch back to your keyboard and paste it.</string>

    <!-- Long press on a sticker: its details, and what can be done with it. -->
    <string name="ime_details_send">Send</string>
    <string name="ime_menu_like">Like</string>
    <string name="ime_menu_unlike">Unlike</string>
    <string name="ime_menu_send_sticker">Send as sticker</string>
    <!-- Instead of ime_menu_send_sticker when a tap sends stickers (settings_keyboard_prefer_stickers). -->
    <string name="ime_menu_send_picture">Send as a picture</string>
    <string name="ime_menu_share">Share</string>
    <string name="ime_liked">Liked.</string>
    <string name="ime_unliked">Like removed.</string>
    <string name="ime_share_title">Share sticker</string>
</resources>
