    <string name="app_error_server">The server answered with an error (%1$d).</string>
    <string name="app_error_storage">Cannot read or write the data of the app on this phone.</string>
    <string name="app_error_other">Something went wrong.</string>
    <string name="app_error_not_a_pairing_link">This link is not a stickpile pairing link.</string>
    <string name="app_error_not_a_pairing_qr">This QR code is not a stickpile pairing code. Scan the one under Settings, Add a device, on the web page of your server.</string>

    <!-- The library cannot be opened (its config is unreadable): a screen of its own. -->
    <string name="app_broken_title">Cannot open your library</string>

    <!-- Onboarding: the first screen. -->
    <string name="onboarding_welcome_title">Welcome to stickpile</string>
    <string name="onboarding_welcome_text">Your stickers and memes from your own server, in the text field of any app.</string>
    <string name="onboarding_scan_text">On the web page of your server, open Settings and choose Add a device. Then scan the QR code it shows.</string>
    <string name="onboarding_scan">Scan the QR code</string>
    <!-- Shown over the camera picture while scanning. -->
    <string name="onboarding_scan_prompt">Point the camera at the QR code on the web page of your server</string>
    <string name="onboarding_enter_code">Enter the code instead</string>
    <string name="onboarding_use_address">Sign in with the server address</string>
    <string name="onboarding_back_to_library">Back to the library</string>
    <string name="onboarding_camera_refused">Without the camera the QR code cannot be scanned. Enter the code instead.</string>

    <!-- Onboarding: the app was opened with a pairing link. -->
    <string name="onboarding_link_title">Pair this phone</string>
    <string name="onboarding_link_text">Pair this phone with this server?</string>
    <string name="onboarding_link_warning">Pair only with a server you trust. If this phone is signed in to another server, it signs out of that one.</string>
    <string name="onboarding_pair">Pair</string>

    <!-- Onboarding: the code typed in. -->
    <string name="onboarding_code_title">Enter the pairing code</string>
    <string name="onboarding_code_text">On the web page of your server, open Settings and choose Add a device. Type in the server address and the code it shows.</string>
    <string name="onboarding_code_label">Pairing code</string>
    <string name="onboarding_code_hint">12 letters and digits</string>
    <!-- %1$s: the code as read, such as 7KQ2-M9XA-4FTR. -->
    <string name="onboarding_code_display">Code: %1$s</string>

    <!-- Onboarding: the server address, then Tailscale or a password. -->
    <string name="onboarding_server_label">Server address</string>
    <string name="onboarding_server_placeholder" translatable="false">https://stickers.example.org</string>
    <string name="onboarding_server_title">Sign in on your server</string>
    <string name="onboarding_server_text">The address of your stickpile server, as you open it in a browser.</string>
    <string name="onboarding_sign_in_title">Sign in</string>
    <!-- %1$s: the server address. -->
    <string name="onboarding_sign_in_server">Server: %1$s</string>
    <string name="onboarding_tailnet_text">If this phone is on the same tailnet as the server, Tailscale signs you in without a password.</string>
    <string name="onboarding_tailnet">Sign in with Tailscale</string>
    <string name="onboarding_tailnet_unknown">The server does not know this phone through Tailscale. Connect the phone to the tailnet of the server, or sign in with your password.</string>
    <string name="onboarding_or">or</string>
    <string name="onboarding_username">Username</string>
    <string name="onboarding_password">Password</string>
    <string name="onboarding_totp">Two-factor code</string>
    <string name="onboarding_totp_notice">This account uses two-factor authentication. Enter the code from your authenticator app.</string>
    <string name="onboarding_sign_in">Sign in</string>

    <!-- The walk-through that turns the picker keyboard on. %1$s: the keyboard's name (ime_name). -->
    <string name="keyboard_setup_title">The sticker keyboard</string>
    <string name="keyboard_setup_intro">stickpile comes with a keyboard of its own, without keys: switch to it in any chat, tap a sticker, and you are back on your usual keyboard.</string>
    <string name="keyboard_setup_enable_title">1. Turn it on</string>
    <string name="keyboard_setup_enable_text">In the list of keyboards, turn on %1$s. Android may warn that a keyboard can read what you type: this one reads only the text in the field, to search for stickers, and you can turn that off in the settings.</string>
    <string name="keyboard_setup_open_settings">Open the keyboard settings</string>
    <string name="keyboard_setup_enabled">Turned on</string>
    <string name="keyboard_setup_switch_title">2. Switch to it</string>
    <string name="keyboard_setup_switch_text">In any app, use the switch-keyboard button of your keyboard or of the navigation bar, and choose %1$s. After you tap a sticker, it switches back to your keyboard.</string>
    <string name="keyboard_setup_switch_first">Turn the keyboard on first.</string>
    <string name="keyboard_setup_show_picker">Show the keyboard switcher</string>
    <string name="keyboard_setup_to_library">Go to my stickers</string>
    <string name="keyboard_setup_skip">Skip for now</string>

