<?xml version="1.0" encoding="utf-8"?>
<!--
  Texts of the app's screens (package ui): onboarding, the keyboard
  walk-through, the library, the settings and the licences. The names
  start with app_, main_, onboarding_, keyboard_setup_, library_,
  settings_ or licence(s)_.
-->
<resources>
    <!-- Buttons used on several screens. -->
    <string name="app_action_back">Back</string>
    <string name="app_action_cancel">Cancel</string>
    <string name="app_action_continue">Continue</string>
    <string name="app_action_done">Done</string>
    <string name="app_action_retry">Try again</string>

    <!-- Errors, one per kind the library reports (ui.common.Failures). -->
