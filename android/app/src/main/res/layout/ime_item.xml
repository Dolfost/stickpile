<?xml version="1.0" encoding="utf-8"?>
<!--
  One sticker in the picker's grid: its thumbnail in a square cell
  (moving, or a video over it, as MotionBinder makes it), and over it
  what Display shows (ItemsAdapter fills them in): the kind and NSFW
  icons in the top-start corner, the offline mark and the heart of a liked one in the top-end
  corner, and lines of text at the bottom. Nothing has a background: the
  icons and the letters carry a dark outline of their own, so they show
  on any sticker (TileIcons, HaloTextView).
-->
<io.github.dolfost.stickpile.ime.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="2dp">

    <ImageView
        android:id="@+id/ime_item_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:padding="2dp"
        android:scaleType="fitCenter" />

    <!-- A video over the still, while it plays (MotionBinder). -->
    <io.github.dolfost.stickpile.motion.LoopingVideoView
        android:id="@+id/ime_item_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="2dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ime_item_badge"
            style="@style/Widget.Stickpile.Ime.TileIcon"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/ime_item_nsfw"
            style="@style/Widget.Stickpile.Ime.TileIcon"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_tile_nsfw" />
    </LinearLayout>

    <!-- Available offline, or not on the phone with the server away; then the heart. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ime_item_offline"
            style="@style/Widget.Stickpile.Ime.TileIcon"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/ime_item_liked"
            style="@style/Widget.Stickpile.Ime.TileIcon"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_tile_heart" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ime_item_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical"
        android:paddingHorizontal="4dp"
        android:paddingVertical="3dp"
        android:visibility="gone">

        <io.github.dolfost.stickpile.ime.HaloTextView
            android:id="@+id/ime_item_name"
            style="@style/Widget.Stickpile.Ime.TileText.Name" />

        <io.github.dolfost.stickpile.ime.HaloTextView
            android:id="@+id/ime_item_emojis"
            style="@style/Widget.Stickpile.Ime.TileText" />

        <io.github.dolfost.stickpile.ime.HaloTextView
            android:id="@+id/ime_item_tags"
            style="@style/Widget.Stickpile.Ime.TileText" />

        <io.github.dolfost.stickpile.ime.HaloTextView
            android:id="@+id/ime_item_text"
            style="@style/Widget.Stickpile.Ime.TileText" />

        <io.github.dolfost.stickpile.ime.HaloTextView
            android:id="@+id/ime_item_stats"
            style="@style/Widget.Stickpile.Ime.TileText" />
    </LinearLayout>
</io.github.dolfost.stickpile.ime.SquareFrameLayout>
