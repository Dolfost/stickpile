<?xml version="1.0" encoding="utf-8"?>
<!--
  One sticker in the picker's grid: its thumbnail in a square cell, and
  over it what Display shows (ItemsAdapter fills them in): the badges in
  the top-start corner, the heart of a liked one in the top-end corner,
  and lines of text on a dark band at the bottom.
-->
<io.github.dolfost.stickpile.ime.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="2dp">

    <ImageView
        android:id="@+id/ime_item_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:padding="2dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="2dp"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ime_item_badge"
            style="@style/Widget.Stickpile.Ime.TileBadge" />

        <TextView
            android:id="@+id/ime_item_nsfw"
            style="@style/Widget.Stickpile.Ime.TileBadge"
            android:background="@drawable/ime_tile_nsfw"
            android:text="@string/display_nsfw_badge" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ime_item_liked"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:background="@drawable/ime_tile_heart"
        android:importantForAccessibility="no"
        android:padding="3dp"
        android:src="@drawable/ic_heart"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/ime_item_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/ime_tile_scrim"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical"
        android:paddingHorizontal="3dp"
        android:paddingVertical="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/ime_item_name"
            style="@style/Widget.Stickpile.Ime.TileText.Name" />

        <TextView
            android:id="@+id/ime_item_emojis"
            style="@style/Widget.Stickpile.Ime.TileText" />

        <TextView
            android:id="@+id/ime_item_tags"
            style="@style/Widget.Stickpile.Ime.TileText" />

        <TextView
            android:id="@+id/ime_item_stats"
            style="@style/Widget.Stickpile.Ime.TileText" />
    </LinearLayout>
</io.github.dolfost.stickpile.ime.SquareFrameLayout>
