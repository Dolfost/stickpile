# Host-specific paths for stickpile.container. Copy to
# 	~/.config/systemd/user/stickpile.service.d/env.conf
# (untracked), then `systemctl --user daemon-reload`. On NixOS generate it from
# home-manager instead (deploy/aorus/stickpile.nix) - do not edit it by hand there.
[Service]
# All state, config.toml and secrets/ (see the quadlet for the layout).
Environment=STICKPILE_DIR=/storage/2.5/stickpile
